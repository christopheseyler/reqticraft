<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:oslc_cm="http://open-services.net/ns/cm#">
<oslc_cm:ChangeRequest rdf:about="https://ccm.example/wi/DES_REQ1"><dcterms:identifier>DES_REQ1</dcterms:identifier><dcterms:title>Échantillonnage du capteur</dcterms:title><dcterms:description>Le capteur est lu par interruption toutes les 10 s.</dcterms:description><oslc_cm:status>Open</oslc_cm:status><oslc_cm:implementsRequirement rdf:resource="https://rm.example/req/THS_REQ1"/></oslc_cm:ChangeRequest>
<oslc_cm:ChangeRequest rdf:about="https://ccm.example/wi/DES_REQ2"><dcterms:identifier>DES_REQ2</dcterms:identifier><dcterms:title>Étalonnage</dcterms:title><dcterms:description>Une table d'étalonnage en 16 points corrige la non-linéarité du capteur.</dcterms:description><oslc_cm:status>Open</oslc_cm:status><oslc_cm:implementsRequirement rdf:resource="https://rm.example/req/THS_REQ2"/></oslc_cm:ChangeRequest>
<oslc_cm:ChangeRequest rdf:about="https://ccm.example/wi/DES_REQ3"><dcterms:identifier>DES_REQ3</dcterms:identifier><dcterms:title>Bornes de consigne</dcterms:title><dcterms:description>La consigne est saturée entre 7 °C et 30 °C.</dcterms:description><oslc_cm:status>Open</oslc_cm:status><oslc_cm:implementsRequirement rdf:resource="https://rm.example/req/THS_REQ3"/></oslc_cm:ChangeRequest>
<oslc_cm:ChangeRequest rdf:about="https://ccm.example/wi/DES_REQ4"><dcterms:identifier>DES_REQ4</dcterms:identifier><dcterms:title>Commande tout-ou-rien</dcterms:title><dcterms:description>Le relais est commandé avec un seuil haut et un seuil bas.</dcterms:description><oslc_cm:status>Open</oslc_cm:status><oslc_cm:implementsRequirement rdf:resource="https://rm.example/req/THS_REQ4"/></oslc_cm:ChangeRequest>
<oslc_cm:ChangeRequest rdf:about="https://ccm.example/wi/DES_REQ5"><dcterms:identifier>DES_REQ5</dcterms:identifier><dcterms:title>API de consigne</dcterms:title><dcterms:description>Une API REST expose la lecture et l'écriture de la consigne.</dcterms:description><oslc_cm:status>Open</oslc_cm:status><oslc_cm:implementsRequirement rdf:resource="https://rm.example/req/THS_REQ6"/><oslc_cm:implementsRequirement rdf:resource="https://rm.example/req/THS_REQ99"/></oslc_cm:ChangeRequest>
<oslc_cm:ChangeRequest rdf:about="https://ccm.example/wi/DES_REQ6"><dcterms:identifier>DES_REQ6</dcterms:identifier><dcterms:title>Chien de garde</dcterms:title><dcterms:description>Un chien de garde redémarre le microcontrôleur après 2 s sans activité.</dcterms:description><oslc_cm:status>Open</oslc_cm:status></oslc_cm:ChangeRequest>
<oslc_cm:ChangeRequest rdf:about="https://ccm.example/wi/DES_REQ7"><dcterms:identifier>DES_REQ7</dcterms:identifier><dcterms:title>Journal d'erreurs</dcterms:title><dcterms:description>Les 100 dernières erreurs sont conservées en mémoire non volatile.</dcterms:description><oslc_cm:status>Open</oslc_cm:status></oslc_cm:ChangeRequest>
</rdf:RDF>
